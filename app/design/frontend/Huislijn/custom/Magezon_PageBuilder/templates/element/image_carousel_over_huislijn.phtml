<script>
require(['jquery'], function ($) {

    $(document).ready(function () {

        function initTimeline() {

            if (!window.Swiper) {
                setTimeout(initTimeline, 100);
                return;
            }

            /* LEFT SWIPER */
            const leftSwiper = new window.Swiper(".leftSwiper", {
                direction: "vertical",
                slidesPerView: 3,
                spaceBetween: 30,
                mousewheel: true,
                freeMode: true,
                watchSlidesProgress: true,
            });

            /* RIGHT SWIPER */
            const rightSwiper = new window.Swiper(".rightSwiper", {
                direction: "vertical",
                slidesPerView: 3,
                spaceBetween: 30,
                mousewheel: true,
                freeMode: true,
                watchSlidesProgress: true,
            });

            /* SYNC BOTH */
            leftSwiper.controller.control = rightSwiper;
            rightSwiper.controller.control = leftSwiper;

            const bar = document.getElementById("progressBar");
            const fill = document.getElementById("progressFill");
            const dot = document.getElementById("progressDot");

            function updateProgress(progress) {

                const max = bar.offsetHeight - dot.offsetHeight;

                const y = progress * max;

                dot.style.top = y + "px";

                fill.style.height = (progress * 100) + "%";
            }

            /* UPDATE ON SWIPE */
            leftSwiper.on("progress", function () {
                updateProgress(leftSwiper.progress);
            });

            updateProgress(0);

            /* DRAG SUPPORT */
            let dragging = false;

            dot.addEventListener("mousedown", function () {
                dragging = true;
            });

            document.addEventListener("mouseup", function () {
                dragging = false;
            });

            document.addEventListener("mousemove", function (e) {

                if (!dragging) return;

                const rect = bar.getBoundingClientRect();

                let y = e.clientY - rect.top;

                const max = rect.height - dot.offsetHeight;

                y = Math.max(0, Math.min(y, max));

                const percent = y / max;

                dot.style.top = y + "px";

                fill.style.height = (percent * 100) + "%";

                /* MOVE BOTH SWIPERS */
                leftSwiper.setProgress(percent);
                rightSwiper.setProgress(percent);

            });

        }

        initTimeline();

    });

});
</script>