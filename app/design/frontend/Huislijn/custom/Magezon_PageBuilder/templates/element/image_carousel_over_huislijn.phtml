<style>

.timeline-wrapper {
    margin: auto;
    padding: 60px 45px;
}

.timeline-layout{
    display:flex;
    gap:40px;
}

/* SWIPERS */
.leftSwiper {
    height:670px;
    padding: 1px 1px !important;
    width: 45%;
}
.rightSwiper {
    height: 780px;
    width: 45%;
    padding: 1px 1px !important;
}
/* SLIDE */
.swiper-slide{
    height:auto !important;
    display:flex;
    align-items:center;
}

/* CARD */
.timeline-card{
    width:100%;
    background:#fff;
    border-radius:12px;
    padding:20px;
    display:flex;
    gap:20px;
    align-items:center;
    box-shadow: 0 0 3px 0 #ccc;
    flex-wrap: wrap;
}

.timeline-content {
    max-width: 60%;
    flex: 0 0 60%;
}
.timeline-year {
    font-size: 24px;
    color: #5b1f2d;
    margin-bottom: 10px;
    width: 100%;
}
.leftSwiper .timeline-year {
    text-align: right;
}
.timeline-text {
    font-size: 18px;
    line-height: 30px;
    color: #6c6c6c;
    font-weight: 300;
}
.timeline-image {
    max-width: 36%;
    flex: 0 0 36%;
}

.timeline-image img{
    width:100%;
    height:100%;
    object-fit:cover;
}

/* CENTER PROGRESS */
.progress-wrapper{
    position:relative;
    width:30px;
    height:780px;
    display:flex;
    justify-content:center;
}
.timeline-wrapper .swiper-slide {
    margin-bottom: 85px !important;
}
.timeline-wrapper .swiper.rightSwiper .swiper-slide {
    margin-bottom: 20px !important;
    margin-top: 90px;
}
.progress-bar{
    width:14px;
    height:100%;
    background:#ddd;
    border-radius:20px;
    position:relative;
}

.progress-fill{
    position:absolute;
    left:0;
    top:0;
    width:100%;
    height:0%;
    background:#5b1f2d;
    border-radius:20px;
}

.progress-dot {
    background: #5b1f2d;
    border-radius: 10px;
    position: absolute;
    left: 50%;
    top: 0;
    transform: translate(-50%,-50%);
    cursor: pointer;
    width: 14px;
    height: 35px;
    text-align: center;
}
.progress-dot::before {
    font-size: 10px;
    content: '\e622';
    font-family: 'luma-icons';
    display: inline-block;
    color: #fff;
    vertical-align: bottom;
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
}

/* MOBILE */
@media(min-width: 1440px) and (max-width:1650px ){
.timeline-content {
    max-width: 59%;
    flex: 0 0 59%;
}
.leftSwiper {
    height: 615px;
}
.progress-wrapper {
    height: 680px;
}
.rightSwiper {
    height: 680px;
}
}
@media(max-width:768px){
.timeline-wrapper {
    padding: 0;
    margin: 50px 0;
    position: relative;
}
.timeline-wrapper .swiper.rightSwiper .swiper-slide {
    margin-top: 0;
}
.timeline-wrapper .swiper-slide {
    margin-bottom: 20px !important;
}
.timeline-content, .timeline-image {
    max-width: 100%;
    flex: 100%;
}
.timeline-layout{
    flex-direction:column;
}

.progress-wrapper {
    height: 100%;
    right: -7px;
    top: 16px;
    position: absolute;
    display: none;
}
.timeline-year {
    margin-bottom: 0;
}
.leftSwiper, .rightSwiper {
    width: 100%;
    height: auto;
}

    .timeline-card {
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
}
.timeline-text {
    font-size: 16px;
    line-height: 26px;
}

.timeline-wrapper.desktop-view{
        display: none;
    } 
}


@media(min-width: 769px){
    .timeline-wrapper.mobile-view{
        display: none;
    } 
}
