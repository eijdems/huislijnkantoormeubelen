<script>
/*
 * Load the FULL Swiper bundle through RequireJS under a dedicated alias.
 * The global `window.Swiper` is unreliable here: in this RequireJS page the
 * UMD bundle does not reliably populate the global, and the `swiper` AMD
 * alias is mapped (by Amasty) to a CORE build that has no Controller /
 * Mousewheel / FreeMode modules. Pulling the bundle by its own alias
 * guarantees every module this timeline depends on is present.
 */
require(['jquery'], function ($) {

    require.config({
        paths: {
            swiperBundle: 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min'
        }
    });

    $(document).ready(function () {

        require(['swiperBundle'], function (Swiper) {

            initTimeline(Swiper || window.Swiper);
        });

        function initTimeline(SwiperClass) {

            if (!SwiperClass) {
                setTimeout(function () { initTimeline(window.Swiper); }, 100);
                return;
            }

            const swiperOptions = {
                direction: "vertical",
                slidesPerView: 3,
                spaceBetween: 30,
                mousewheel: true,
                freeMode: true,
                watchSlidesProgress: true,
            };

            /* The selector ".leftSwiper" matches BOTH the desktop and mobile
               markup, and Swiper returns an ARRAY of instances when a selector
               matches more than one node. Instantiate against specific
               elements so we always get a single instance. */
            const leftEl = document.querySelector(".desktop-view .leftSwiper");
            const rightEl = document.querySelector(".desktop-view .rightSwiper");

            if (!leftEl || !rightEl) {
                return;
            }

            /* LEFT SWIPER */
            const leftSwiper = new SwiperClass(leftEl, swiperOptions);

            /* RIGHT SWIPER */
            const rightSwiper = new SwiperClass(rightEl, swiperOptions);

            /* MOBILE SWIPER (separate, un-synced) */
            const mobileLeftEl = document.querySelector(".mobile-view .leftSwiper");
            if (mobileLeftEl) {
                new SwiperClass(mobileLeftEl, swiperOptions);
            }

            /* SYNC BOTH — use the Controller module when available, otherwise
               fall back to a manual progress sync so a missing module can
               never abort the rest of the initialisation. */
            if (leftSwiper.controller && rightSwiper.controller) {
                leftSwiper.controller.control = rightSwiper;
                rightSwiper.controller.control = leftSwiper;
            } else {
                leftSwiper.on("progress", function () {
                    rightSwiper.setProgress(leftSwiper.progress);
                });
                rightSwiper.on("progress", function () {
                    leftSwiper.setProgress(rightSwiper.progress);
                });
            }

            const bar = document.getElementById("progressBar");
            const fill = document.getElementById("progressFill");
            const dot = document.getElementById("progressDot");

            function updateProgress(progress) {

                const max = bar.offsetHeight - dot.offsetHeight;

                const y = progress * max;

                dot.style.top = y + "px";

                fill.style.height = (progress * 100) + "%";
            }

            /* The dot is read-only: it only reflects the scroll position.
               The timeline is moved with the mouse-wheel, and the dot/fill
               stay in sync via Swiper's "progress" event. */
            leftSwiper.on("progress", function () {
                updateProgress(leftSwiper.progress);
            });

            updateProgress(0);

        }

    });

});
</script>