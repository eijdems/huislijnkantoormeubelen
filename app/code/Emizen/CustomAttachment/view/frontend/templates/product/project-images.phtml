 * @var \Emizen\CustomAttachment\Block\Product\ProjectImages $block
 * @var \Magento\Framework\Escaper $escaper
 */

if (!$block->getCustomLogin()) {
    return;
}

$groups = $block->getGroupedProjectImages();
if (empty($groups)) {
    return;
}
?>
<section class="emizen-project-images">
    <h2 class="emizen-project-images__title"><?= $escaper->escapeHtml(__('Sfeerafbeeldingen')) ?></h2>
    <?php foreach ($groups as $group): ?>
        <?php if (empty($group['images'])) {
            continue;
        } ?>
        <div class="emizen-project-images__group">
            <?php if (!empty($group['category'])): ?>
                <h3 class="emizen-project-images__category"><?= $escaper->escapeHtml($group['category']) ?></h3>
            <?php endif; ?>
            <div class="emizen-project-images__strip">
                <?php foreach ($group['images'] as $image): ?>
                    <a class="emizen-project-images__item"
                       href="<?= $escaper->escapeUrl($image['download_url']) ?>"
                       title="<?= $escaper->escapeHtmlAttr($image['title']) ?>">
                        <img src="<?= $escaper->escapeUrl($image['url']) ?>"
                             alt="<?= $escaper->escapeHtmlAttr($image['title']) ?>"
                             loading="lazy"/>
                    </a>
                <?php endforeach; ?>
            </div>
        </div>
    <?php endforeach; ?>
</section>

<style>
    .emizen-project-images {
        width: 100%;
        margin: 40px 0;
    }
    .emizen-project-images__title {
        font-size: 24px;
        margin-bottom: 20px;
    }
    .emizen-project-images__category {
        font-size: 18px;
        margin: 20px 0 12px;
    }
    .emizen-project-images__strip {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
    }
    .emizen-project-images__item {
        flex: 0 1 calc(20% - 12px);
        display: block;
        overflow: hidden;
    }
    .emizen-project-images__item img {
        width: 100%;
        height: 220px;
        object-fit: cover;
        display: block;
        transition: transform .3s ease;
    }
    .emizen-project-images__item:hover img {
        transform: scale(1.04);
    }
    @media (max-width: 1024px) {
        .emizen-project-images__item {
            flex-basis: calc(33.333% - 10px);
        }
    }
    @media (max-width: 640px) {
        .emizen-project-images__item {
            flex-basis: calc(50% - 8px);
        }
        .emizen-project-images__item img {
            height: 160px;
        }
    }
</style>
