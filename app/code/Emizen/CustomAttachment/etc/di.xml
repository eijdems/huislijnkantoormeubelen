<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <virtualType name="Emizen\CustomAttachment\Model\ProjectImageUploader" type="Emizen\CustomAttachment\Model\ImageUploader">
        <arguments>
            <argument name="basePath" xsi:type="string">emizen/project_images</argument>
            <argument name="allowedExtensions" xsi:type="array">
                <item name="jpg" xsi:type="string">jpg</item>
                <item name="jpeg" xsi:type="string">jpeg</item>
                <item name="png" xsi:type="string">png</item>
                <item name="gif" xsi:type="string">gif</item>
                <item name="webp" xsi:type="string">webp</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="Emizen\CustomAttachment\Controller\Adminhtml\Image\Upload">
        <arguments>
            <argument name="imageUploader" xsi:type="object">Emizen\CustomAttachment\Model\ProjectImageUploader</argument>
        </arguments>
    </type>
</config>
