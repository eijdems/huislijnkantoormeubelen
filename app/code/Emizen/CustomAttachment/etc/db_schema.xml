<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="emizen_attachment_project_image" resource="default" engine="innodb" comment="FME Attachment Project Images">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity Id"/>
        <column xsi:type="int" name="attachment_id" padding="10" unsigned="true" nullable="false" comment="FME Attachment Id"/>
        <column xsi:type="varchar" name="image" length="255" nullable="false" comment="Relative media path of the image"/>
        <column xsi:type="int" name="position" padding="11" unsigned="false" nullable="false" default="0" comment="Sort Order"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="EMIZEN_ATTACHMENT_PROJECT_IMAGE_ATTACHMENT_ID_PRODUCTATTACHMENTS_ID"
                    table="emizen_attachment_project_image" column="attachment_id"
                    referenceTable="productattachments" referenceColumn="productattachments_id" onDelete="CASCADE"/>
        <index referenceId="EMIZEN_ATTACHMENT_PROJECT_IMAGE_ATTACHMENT_ID" indexType="btree">
            <column name="attachment_id"/>
        </index>
    </table>
</schema>
